# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# rendered / generated artifacts (mockups, screenshots, images)
/output/
*.png.png
screenshots/
/mockups/

# misc
.DS_Store
*.pem

# debug
.logs/
/.next-dev.log
/.next-dev-error.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.factory.claude/worktrees/

# editor/agent tooling
.claude/
/.vscode/
.vscode/settings.json
/.pi/

# ephemeral / temp dirs (auto-generated, not tracked)
.agent-teams/
.freebuff/
.jspace/

# windows
Thumbs.db
Desktop.ini

# local tooling cruft
.tmp/
tmp/
*.log
